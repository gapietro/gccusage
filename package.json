{
  "name": "gccusage",
  "version": "0.1.0",
  "description": "Powerline-style statusline for Claude Code — model info, costs, context usage, git status, and more",
  "type": "module",
  "bin": {
    "gccusage": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "postbuild": "node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c)\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "bun run src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "powerline",
    "terminal",
    "cli",
    "anthropic",
    "ai",
    "usage",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gapietro/gccusage.git"
  },
  "homepage": "https://github.com/gapietro/gccusage#readme",
  "bugs": {
    "url": "https://github.com/gapietro/gccusage/issues"
  },
  "author": "gapietro",
  "dependencies": {
    "chalk": "^5.4.1",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
