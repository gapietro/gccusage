node_modules/
*.tsbuildinfo
.cache/
coverage/

# Build output. dist/index.js is deliberately committed: `gccusage setup`
# points Claude Code's statusLine.command at it, so anyone upgrading with
# `git pull` runs this file directly and never builds. It must be rebuilt and
# staged in the same commit as any src/ change, which is why it is un-ignored
# here rather than force-added — `git status` has to show it as dirty.
dist/*
!dist/index.js

# Local Claude Code state, per-machine and not shareable.
.claude/settings.local.json
.claude/worktrees/
.superpowers/

# Implementation plans and design specs, kept locally but not published. They
# were working documents for individual changes, not reference material: nothing
# in the repo links to them, and the reasoning worth keeping was folded into the
# code comments and commit messages at the time. Untracked rather than deleted —
# they stay on disk.
docs/

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
